Export_Ruta() {
    local nombre="$1"
    local ruta="${(P)nombre}"

    if [[ -d "$ruta" ]]; then
        export "$nombre"
    else
        echo "  ╭──────────────────╮"
        echo "  │   Ruta Fallido   │"
        echo "  ╰──────────────────╯"
        echo "  -> $nombre"
        echo "  -> $ruta" >&2
        return 1
    fi
}
